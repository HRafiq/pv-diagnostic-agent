# Copy to .env (gitignored) and fill in.

# Required only by the agent nodes. Physics, detectors, the fault simulator and
# the dashboard all run without it.
ANTHROPIC_API_KEY=

# Which block of config/models.yaml to use: default (cost-tuned) or quality.
PV_MODEL_PROFILE=default

# Optional overrides. All three directories are gitignored.
# PV_DATA_DIR=./data
# PV_TRACES_DIR=./traces
# PV_CORPUS_DIR=./corpus
